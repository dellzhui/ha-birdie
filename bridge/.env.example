# Copy to .env.local (git-ignored) and fill in locally. Never commit real values.
# Load into the shell with:  set -a; . ./.env.local; set +a
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# One of: cn, us, us_east, eu, eu_west, in, sg  (or set TUYA_ENDPOINT to a full https URL)
TUYA_REGION=eu
# Optional: default device id for the dev tool
TUYA_DEVICE_ID=

# Bridge server (python -m birdie_bridge). Development only:
BRIDGE_ENV=development
# token=tuya_uid pairs; pick long random tokens
BRIDGE_DEV_TOKENS=
# OAuth sign-in test users: email:password=tuya_uid pairs
BRIDGE_DEV_USERS=
# Extra pid=model mappings, e.g. a cloned test product: <pid>=pedestal
BRIDGE_EXTRA_PRODUCTS=
BRIDGE_PORT=8080
